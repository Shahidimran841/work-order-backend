<!doctype html>
<html>
<head>
  <title>Activity Logs - Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/public/admin.css" />
</head>

<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <div class="admin-brand">Work Order Admin</div>
      <div class="admin-brand-subtitle">Manage reports, photos and technicians</div>

      <div class="admin-nav">
        <a href="/admin">Dashboard</a>
        <a href="/admin/work-orders">Work Orders</a>
        <a href="/admin/technicians">Technicians</a>
        <a href="/admin/email-recipients">Email Setup</a>
        <a href="/admin/ppt-settings">PPT Settings</a>
        <a class="active" href="/admin/activity-logs">Activity Logs</a>
        <a href="/admin/backups">Backups</a>

        <form method="POST" action="/admin/logout" class="mt-3">
          <button type="submit">Logout</button>
        </form>
      </div>
    </aside>

    <main class="admin-content">
      <div class="mb-4">
        <h3 class="page-title">Activity Logs</h3>
        <p class="page-subtitle">Track important admin actions such as approvals, PPT generation, email sending and deletions.</p>
      </div>

      <div class="help-box">
        This page helps you understand what actions were performed in the admin panel and when they happened.
      </div>

      <div class="card admin-card">
        <div class="card-header">Recent Activity</div>

        <div class="card-body">
          <% if (logs.length === 0) { %>
            <p class="text-muted mb-0">No activity logs yet.</p>
          <% } else { %>
            <div class="table-responsive">
              <table class="table align-middle">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Action</th>
                    <th>User</th>
                    <th>Details</th>
                    <th>Time</th>
                  </tr>
                </thead>

                <tbody>
                  <% logs.forEach(function(log) { %>
                    <tr>
                      <td><%= log.id %></td>
                      <td><span class="badge bg-primary"><%= log.action %></span></td>
                      <td>
                        <%= log.user_name || 'System' %><br />
                        <small class="text-muted"><%= log.user_phone || '' %></small>
                      </td>
                      <td><small><%= log.details || '-' %></small></td>
                      <td><small><%= log.created_at %></small></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
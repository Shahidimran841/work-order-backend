<!doctype html>
<html>
<head>
  <title>PPT Settings - Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/public/admin.css" />
</head>

<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
  <div class="admin-logo-wrap">
    <div class="admin-logo">WO</div>
    <div>
      <div class="admin-brand">Work Order Admin</div>
      <div class="admin-brand-subtitle">Operations Portal</div>
    </div>
  </div>

  <div class="admin-nav">
    <a href="/admin">
      <span class="admin-nav-icon">▣</span>
      Dashboard
    </a>

    <a href="/admin/work-orders">
      <span class="admin-nav-icon">▤</span>
      Work Orders
    </a>

    <a href="/admin/technicians">
      <span class="admin-nav-icon">◉</span>
      Technicians
    </a>

    <a class="active" href="/admin/email-recipients">
      <span class="admin-nav-icon">✉</span>
      Email Setup
    </a>

    <a href="/admin/ppt-settings">
      <span class="admin-nav-icon">▧</span>
      PPT Settings
    </a>

    <a href="/admin/activity-logs">
      <span class="admin-nav-icon">◎</span>
      Activity Logs
    </a>

    <a href="/admin/backups">
      <span class="admin-nav-icon">⬒</span>
      Backups
    </a>

    <form method="POST" action="/admin/logout" class="mt-3">
      <button type="submit">
        <span class="admin-nav-icon">↳</span>
        Logout
      </button>
    </form>
  </div>
</aside>

    <main class="admin-content">
      <div class="mb-4">
        <h3 class="page-title">PPT Settings</h3>
        <p class="page-subtitle">Control footer text and layout settings for generated PowerPoint reports.</p>
      </div>

      <% if (message) { %>
        <div class="alert alert-success"><%= message %></div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <div class="help-box">
        These settings appear in generated PPT reports. Update them before generating final client reports.
      </div>

      <div class="row g-4">
        <div class="col-lg-7">
          <div class="card admin-card">
            <div class="card-header">Footer Settings</div>

            <div class="card-body">
              <form method="POST" action="/admin/ppt-settings">
                <div class="mb-3">
                  <label class="form-label fw-semibold">Project Name</label>
                  <input
                    class="form-control"
                    name="projectName"
                    value="<%= settings.projectName || '' %>"
                    placeholder="Enter project name"
                  />
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold">Contract / Project Code</label>
                  <input
                    class="form-control"
                    name="projectCode"
                    value="<%= settings.projectCode || '' %>"
                    placeholder="Enter contract/project code"
                  />
                </div>

                <hr />

                <div class="form-check form-switch mb-2">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    name="showFooter"
                    <%= settings.showFooter ? 'checked' : '' %>
                  />
                  <label class="form-check-label">Show Footer</label>
                </div>

                <div class="form-check form-switch mb-2">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    name="showProjectName"
                    <%= settings.showProjectName ? 'checked' : '' %>
                  />
                  <label class="form-check-label">Show Project Name</label>
                </div>

                <div class="form-check form-switch mb-2">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    name="showProjectCode"
                    <%= settings.showProjectCode ? 'checked' : '' %>
                  />
                  <label class="form-check-label">Show Contract / Project Code</label>
                </div>

                <div class="form-check form-switch mb-2">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    name="showWorkOrderNumber"
                    <%= settings.showWorkOrderNumber ? 'checked' : '' %>
                  />
                  <label class="form-check-label">Show Work Order Number</label>
                </div>

                <div class="form-check form-switch mb-4">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    name="showPageNumber"
                    <%= settings.showPageNumber ? 'checked' : '' %>
                  />
                  <label class="form-check-label">Show Page Number</label>
                </div>

                <button class="btn btn-primary" type="submit">
                  Save PPT Settings
                </button>
              </form>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="card admin-card">
            <div class="card-header">Photo Layout Rules</div>

            <div class="card-body">
              <ul class="mb-0">
                <li>Maximum 3 photos per page.</li>
                <li>If 3 photos are available, they use 3 equal slots.</li>
                <li>If 2 photos are left, they use 50% / 50% layout.</li>
                <li>If 1 photo is left, it uses the full photo area.</li>
                <li>Header logos and selected footer fields remain visible.</li>
                <li>Page number format is: Page Number: 1 of 7.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
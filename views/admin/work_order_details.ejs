<!doctype html>
<html>
<head>
  <title>Work Order Details - Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/public/admin.css" />
</head>

<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
  <div class="admin-logo-wrap">
    <div class="admin-logo">WO</div>
    <div>
      <div class="admin-brand">Work Order Admin</div>
      <div class="admin-brand-subtitle">Operations Portal</div>
    </div>
  </div>

  <div class="admin-nav">
    <a href="/admin">
      <span class="admin-nav-icon">▣</span>
      Dashboard
    </a>

    <a class="active" href="/admin/work-orders">
      <span class="admin-nav-icon">▤</span>
      Work Orders
    </a>

    <a href="/admin/technicians">
      <span class="admin-nav-icon">◉</span>
      Technicians
    </a>

    <a href="/admin/email-recipients">
      <span class="admin-nav-icon">✉</span>
      Email Setup
    </a>

    <a href="/admin/ppt-settings">
      <span class="admin-nav-icon">▧</span>
      PPT Settings
    </a>

    <a href="/admin/activity-logs">
      <span class="admin-nav-icon">◎</span>
      Activity Logs
    </a>

    <a href="/admin/backups">
      <span class="admin-nav-icon">⬒</span>
      Backups
    </a>

    <form method="POST" action="/admin/logout" class="mt-3">
      <button type="submit">
        <span class="admin-nav-icon">↳</span>
        Logout
      </button>
    </form>
  </div>
</aside>

    <main class="admin-content">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
        <div>
          <h3 class="page-title">Work Order: <%= workOrder.work_order_number %></h3>
          <p class="page-subtitle">
            Asset ID: <%= workOrder.asset_id || '-' %>
          </p>
        </div>

        <a href="/admin/work-orders" class="btn btn-outline-secondary">
          Back to Work Orders
        </a>
      </div>

      <div class="card admin-card mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between flex-wrap gap-3">
            <div>
              <div class="mb-2">
                <span class="badge bg-primary"><%= workOrder.status %></span>

                <% if (workOrder.is_edited == 1) { %>
                  <span class="badge bg-warning text-dark">Edited</span>
                <% } %>

                <% if (workOrder.ppt_status === 'needs_regeneration') { %>
                  <span class="badge bg-warning text-dark">PPT Needs Regeneration</span>
                <% } else if (workOrder.ppt_status === 'generated') { %>
                  <span class="badge bg-success">PPT Generated</span>
                <% } else if (workOrder.ppt_status === 'failed') { %>
                  <span class="badge bg-danger">PPT Failed</span>
                <% } else { %>
                  <span class="badge bg-secondary"><%= workOrder.ppt_status || 'not_generated' %></span>
                <% } %>

                <% if (workOrder.email_status === 'sent') { %>
                  <span class="badge bg-success">Email Sent</span>
                <% } else if (workOrder.email_status === 'test_mode') { %>
                  <span class="badge bg-info text-dark">Email Test Mode</span>
                <% } else if (workOrder.email_status === 'failed') { %>
                  <span class="badge bg-danger">Email Failed</span>
                <% } else if (workOrder.email_status === 'sending') { %>
                  <span class="badge bg-primary">Email Sending</span>
                <% } else { %>
                  <span class="badge bg-secondary">Email Not Sent</span>
                <% } %>
              </div>

              <h5 class="mb-1">Report Review</h5>
              <p class="text-muted mb-0">
                Check photos first, then generate the PPT. If everything is correct, send the email.
              </p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
              <form method="POST" action="/admin/work-orders/<%= workOrder.id %>/generate-ppt">
                <button class="btn btn-success btn-sm" type="submit">
                  <%= workOrder.ppt_status === 'generated' ? 'Regenerate PPT' : 'Generate PPT' %>
                </button>
              </form>

              <form method="POST" action="/admin/work-orders/<%= workOrder.id %>/generate-ppt-and-send-email">
                <button class="btn btn-warning btn-sm" type="submit">
                  Generate PPT + Send Email
                </button>
              </form>

              <% if (workOrder.ppt_status === 'generated' && workOrder.ppt_file_path) { %>
                <a
                  class="btn btn-outline-primary btn-sm"
                  href="/admin/work-orders/<%= workOrder.id %>/download-ppt"
                >
                  Download PPT
                </a>

                <form method="POST" action="/admin/work-orders/<%= workOrder.id %>/send-email">
                  <button class="btn btn-outline-success btn-sm" type="submit">
                    Send Email
                  </button>
                </form>
              <% } %>

              <form
                method="POST"
                action="/admin/work-orders/<%= workOrder.id %>/delete"
                onsubmit="return confirm('Are you sure you want to delete this complete work order? This action cannot be undone.');"
              >
                <button class="btn btn-outline-danger btn-sm" type="submit">
                  Delete
                </button>
              </form>
            </div>
          </div>

          <hr />

          <% if (workOrder.is_edited == 1) { %>
            <div class="alert alert-warning border-warning">
              <div class="fw-bold mb-1">
                This work order was edited after original submission.
              </div>

              <div><strong>Edit Count:</strong> <%= workOrder.edit_count || 1 %></div>
              <div><strong>Last Added Photos:</strong> <%= workOrder.last_added_photo_count || 0 %></div>
              <div><strong>Last Edited At:</strong> <%= workOrder.edited_at || '-' %></div>

              <div class="mt-2 small">
                Please regenerate the PPT so the newly added photos are included in the report.
              </div>
            </div>
          <% } %>

          <div class="row g-3">
            <div class="col-md-3">
              <strong>Technician</strong><br />
              <%= workOrder.technician_name || 'Unknown' %><br />
              <small class="text-muted"><%= workOrder.technician_phone || '' %></small>
            </div>

            <div class="col-md-3">
              <strong>Job Title</strong><br />
              <%= workOrder.technician_job_title || '-' %>
            </div>

            <div class="col-md-3">
              <strong>Submitted At</strong><br />
              <%= workOrder.submitted_at || '-' %>
            </div>

            <div class="col-md-3">
              <strong>Total Photos</strong><br />
              <%= totalPhotos || 0 %>
            </div>

            <div class="col-md-12">
              <strong>Notes</strong><br />
              <%= workOrder.notes || '-' %>
            </div>
          </div>
        </div>
      </div>

      <% if (workOrder.email_sent_at || workOrder.email_error) { %>
        <div class="card admin-card mb-4">
          <div class="card-header">Email Status</div>
          <div class="card-body">
            <p class="mb-1">
              <strong>Status:</strong>
              <%= workOrder.email_status || 'not_sent' %>
            </p>

            <% if (workOrder.email_sent_at) { %>
              <p class="mb-1">
                <strong>Time:</strong>
                <%= workOrder.email_sent_at %>
              </p>
            <% } %>

            <% if (workOrder.email_error) { %>
              <p class="mb-0 text-danger">
                <strong>Message:</strong>
                <%= workOrder.email_error %>
              </p>
            <% } %>
          </div>
        </div>
      <% } %>

      <% const stages = ['Before', 'During', 'After', 'Progress', 'Other']; %>

      <% stages.forEach(function(stage) { %>
        <div class="mb-4">
          <h5 class="section-title"><%= stage %> Photos (<%= groupedPhotos[stage].length %>)</h5>

          <% if (groupedPhotos[stage].length === 0) { %>
            <div class="alert alert-light border">No <%= stage %> photos.</div>
          <% } else { %>
            <div class="row g-3">
              <% groupedPhotos[stage].forEach(function(photo) { %>
                <div class="col-md-4">
                  <div class="card admin-card photo-card">
                    <div class="card-body">
                      <a href="<%= photo.url %>" target="_blank">
                        <img src="<%= photo.url %>" alt="<%= photo.stage %> photo" />
                      </a>

                      <div class="mt-3">
                        <div><strong>Stage:</strong> <%= photo.stage %></div>
                        <div><strong>Time:</strong> <%= photo.display_time || '-' %></div>
                        <div><strong>GPS:</strong> <%= photo.latitude || '-' %>, <%= photo.longitude || '-' %></div>
                      </div>

                      <form
                        method="POST"
                        action="/admin/work-orders/<%= workOrder.id %>/photos/<%= photo.id %>/delete"
                        class="mt-3"
                        onsubmit="return confirm('Delete this photo? This cannot be undone.');"
                      >
                        <button class="btn btn-sm btn-outline-danger w-100" type="submit">
                          Remove Bad Photo
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </main>
  </div>
</body>
</html>
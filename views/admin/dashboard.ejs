<!doctype html>
<html>
<head>
  <title>Admin Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/public/admin.css" />
</head>

<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <div class="admin-brand">Work Order Admin</div>
      <div class="admin-brand-subtitle">Manage reports, photos and technicians</div>

      <div class="admin-nav">
        <a class="active" href="/admin">Dashboard</a>
        <a href="/admin/work-orders">Work Orders</a>
        <a href="/admin/technicians">Technicians</a>
        <a href="/admin/email-recipients">Email Setup</a>
        <a href="/admin/ppt-settings">PPT Settings</a>
        <a href="/admin/activity-logs">Activity Logs</a>
        <a href="/admin/backups">Backups</a>

        <form method="POST" action="/admin/logout" class="mt-3">
          <button type="submit">Logout</button>
        </form>
      </div>
    </aside>

    <main class="admin-content">
      <div class="mb-4">
        <h3 class="page-title">Dashboard</h3>
        <p class="page-subtitle">Overview of technicians, work orders, photos and reports.</p>
      </div>

      <!-- Search Bar -->
      <div class="card admin-card mb-4">
        <div class="card-body">
          <form method="GET" action="/admin/work-orders" class="row g-2 align-items-center">
            <div class="col-md-10">
              <input
                type="text"
                name="search"
                class="form-control"
                placeholder="Search work order number or asset ID..."
              />
            </div>
            <div class="col-md-2">
              <button class="btn btn-primary w-100" type="submit">
                Search
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Quick Buttons -->
      <div class="card admin-card mb-4">
        <div class="card-header">Quick Actions</div>
        <div class="card-body">
          <div class="quick-actions">
            <a href="/admin/work-orders" class="quick-btn">Work Orders</a>
            <a href="/admin/technicians" class="quick-btn">Technicians</a>
            <a href="/admin/email-recipients" class="quick-btn">Email Setup</a>
            <a href="/admin/ppt-settings" class="quick-btn">PPT Settings</a>
            <a href="/admin/activity-logs" class="quick-btn">Logs</a>
            <a href="/admin/backups" class="quick-btn">Backups</a>
          </div>
        </div>
      </div>

      <!-- Stats -->
      <div class="row g-3 mb-4">
        <div class="col-md-3">
          <div class="stat-card">
            <div class="stat-label">Technicians</div>
            <div class="stat-value"><%= stats.totalTechnicians %></div>
            <div class="stat-hint">Registered app users</div>
          </div>
        </div>

        <div class="col-md-3">
          <div class="stat-card">
            <div class="stat-label">Pending</div>
            <div class="stat-value"><%= stats.pendingTechnicians %></div>
            <div class="stat-hint">Waiting for approval</div>
          </div>
        </div>

        <div class="col-md-3">
          <div class="stat-card">
            <div class="stat-label">Work Orders</div>
            <div class="stat-value"><%= stats.totalWorkOrders %></div>
            <div class="stat-hint">Uploaded records</div>
          </div>
        </div>

        <div class="col-md-3">
          <div class="stat-card">
            <div class="stat-label">Photos</div>
            <div class="stat-value"><%= stats.totalPhotos %></div>
            <div class="stat-hint">Captured images</div>
          </div>
        </div>
      </div>

      <!-- Recent Work Orders -->
      <div class="card admin-card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span>Recent Work Orders</span>
          <a href="/admin/work-orders" class="btn btn-sm btn-outline-primary">View All</a>
        </div>

        <div class="card-body">
          <% if (recentWorkOrders.length === 0) { %>
            <p class="text-muted mb-0">No work orders uploaded yet.</p>
          <% } else { %>
            <div class="table-responsive">
              <table class="table align-middle">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Work Order</th>
                    <th>Asset ID</th>
                    <th>Technician</th>
                    <th>Photos</th>
                    <th>Status</th>
                    <th>PPT</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentWorkOrders.forEach(function(order) { %>
                    <tr>
                      <td><%= order.id %></td>
                      <td class="fw-bold"><%= order.work_order_number %></td>
                      <td><%= order.asset_id || '-' %></td>
                      <td>
                        <%= order.technician_name || 'Unknown' %><br />
                        <small class="text-muted"><%= order.technician_phone || '' %></small>
                      </td>
                      <td><%= order.photo_count %></td>
                      <td><span class="badge bg-primary"><%= order.status %></span></td>
                      <td>
                        <% if (order.ppt_status === 'generated') { %>
                          <span class="badge bg-success">Generated</span>
                        <% } else if (order.ppt_status === 'needs_regeneration') { %>
                          <span class="badge bg-warning text-dark">Needs Regen</span>
                        <% } else { %>
                          <span class="badge bg-secondary"><%= order.ppt_status || 'not_generated' %></span>
                        <% } %>
                      </td>
                      <td>
                        <a class="btn btn-sm btn-outline-primary" href="/admin/work-orders/<%= order.id %>">
                          Review
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
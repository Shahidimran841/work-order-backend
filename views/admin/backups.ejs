<!doctype html>
<html>
<head>
  <title>Backups - Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/public/admin.css" />
</head>

<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
  <div class="admin-logo-wrap">
    <div class="admin-logo">WO</div>
    <div>
      <div class="admin-brand">Work Order Admin</div>
      <div class="admin-brand-subtitle">Operations Portal</div>
    </div>
  </div>

  <div class="admin-nav">
    <a href="/admin">
      <span class="admin-nav-icon">▣</span>
      Dashboard
    </a>

    <a href="/admin/work-orders">
      <span class="admin-nav-icon">▤</span>
      Work Orders
    </a>

    <a href="/admin/technicians">
      <span class="admin-nav-icon">◉</span>
      Technicians
    </a>

    <a class="active" href="/admin/email-recipients">
      <span class="admin-nav-icon">✉</span>
      Email Setup
    </a>

    <a href="/admin/ppt-settings">
      <span class="admin-nav-icon">▧</span>
      PPT Settings
    </a>

    <a href="/admin/activity-logs">
      <span class="admin-nav-icon">◎</span>
      Activity Logs
    </a>

    <a href="/admin/backups">
      <span class="admin-nav-icon">⬒</span>
      Backups
    </a>

    <form method="POST" action="/admin/logout" class="mt-3">
      <button type="submit">
        <span class="admin-nav-icon">↳</span>
        Logout
      </button>
    </form>
  </div>
</aside>

    <main class="admin-content">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
        <div>
          <h3 class="page-title">Backups</h3>
          <p class="page-subtitle">Create and download backups of the database, uploaded photos and generated reports.</p>
        </div>

        <form method="POST" action="/admin/backups/create">
          <button class="btn btn-primary" type="submit">
            Create New Backup
          </button>
        </form>
      </div>

      <% if (message) { %>
        <div class="alert alert-success"><%= message %></div>
      <% } %>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <div class="help-box">
        A backup includes the SQLite database, uploaded work order photos, and generated PPT reports.
      </div>

      <div class="row g-3 mb-4">
        <div class="col-md-4">
          <div class="stat-card">
            <div class="stat-label">Database</div>
            <div class="stat-value">SQLite</div>
            <div class="stat-hint">Work orders, users and settings</div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="stat-card">
            <div class="stat-label">Photos</div>
            <div class="stat-value">Files</div>
            <div class="stat-hint">Uploaded before, during and after photos</div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="stat-card">
            <div class="stat-label">Reports</div>
            <div class="stat-value">PPT</div>
            <div class="stat-hint">Generated PowerPoint reports</div>
          </div>
        </div>
      </div>

      <div class="card admin-card">
        <div class="card-header">Available Backups</div>

        <div class="card-body">
          <% if (backups.length === 0) { %>
            <p class="text-muted mb-0">No backups created yet.</p>
          <% } else { %>
            <div class="table-responsive">
              <table class="table align-middle">
                <thead>
                  <tr>
                    <th>File Name</th>
                    <th>Size</th>
                    <th>Created</th>
                    <th>Download</th>
                  </tr>
                </thead>

                <tbody>
                  <% backups.forEach(function(backup) { %>
                    <tr>
                      <td class="fw-bold"><%= backup.fileName %></td>
                      <td><%= Math.round(backup.size / 1024) %> KB</td>
                      <td><%= backup.createdAt.toLocaleString() %></td>
                      <td>
                        <a
                          class="btn btn-sm btn-outline-primary"
                          href="/admin/backups/<%= backup.fileName %>/download"
                        >
                          Download
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
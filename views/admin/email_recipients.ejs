<!doctype html>
<html>
<head>
  <title>Email Setup - Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/public/admin.css" />
</head>

<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
  <div class="admin-logo-wrap">
    <div class="admin-logo">WO</div>
    <div>
      <div class="admin-brand">Work Order Admin</div>
      <div class="admin-brand-subtitle">Operations Portal</div>
    </div>
  </div>

  <div class="admin-nav">
    <a href="/admin">
      <span class="admin-nav-icon">▣</span>
      Dashboard
    </a>

    <a href="/admin/work-orders">
      <span class="admin-nav-icon">▤</span>
      Work Orders
    </a>

    <a href="/admin/technicians">
      <span class="admin-nav-icon">◉</span>
      Technicians
    </a>

    <a class="active" href="/admin/email-recipients">
      <span class="admin-nav-icon">✉</span>
      Email Setup
    </a>

    <a href="/admin/ppt-settings">
      <span class="admin-nav-icon">▧</span>
      PPT Settings
    </a>

    <a href="/admin/activity-logs">
      <span class="admin-nav-icon">◎</span>
      Activity Logs
    </a>

    <a href="/admin/backups">
      <span class="admin-nav-icon">⬒</span>
      Backups
    </a>

    <form method="POST" action="/admin/logout" class="mt-3">
      <button type="submit">
        <span class="admin-nav-icon">↳</span>
        Logout
      </button>
    </form>
  </div>
</aside>

    <main class="admin-content">
      <div class="mb-4">
        <h3 class="page-title">Email Setup</h3>
        <p class="page-subtitle">Add the recipients who should receive generated PPT work order reports.</p>
      </div>

      <div class="help-box">
        Keep at least one recipient active. Reports will only be emailed to active recipients.
      </div>

      <div class="card admin-card mb-4">
        <div class="card-header">Add Recipient</div>

        <div class="card-body">
          <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>

          <form method="POST" action="/admin/email-recipients" class="row g-2">
            <div class="col-md-4">
              <input class="form-control" name="name" placeholder="Recipient Name Optional" />
            </div>

            <div class="col-md-5">
              <input class="form-control" type="email" name="email" placeholder="recipient@example.com" required />
            </div>

            <div class="col-md-3">
              <button class="btn btn-primary w-100" type="submit">Add Email</button>
            </div>
          </form>
        </div>
      </div>

      <div class="card admin-card">
        <div class="card-header">Saved Recipients</div>

        <div class="card-body">
          <% if (recipients.length === 0) { %>
            <p class="text-muted mb-0">No email recipients added yet.</p>
          <% } else { %>
            <div class="table-responsive">
              <table class="table align-middle">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Action</th>
                  </tr>
                </thead>

                <tbody>
                  <% recipients.forEach(function(recipient) { %>
                    <tr>
                      <td class="fw-bold"><%= recipient.name || '-' %></td>
                      <td><%= recipient.email %></td>
                      <td>
                        <% if (recipient.is_active === 1) { %>
                          <span class="badge bg-success">Active</span>
                        <% } else { %>
                          <span class="badge bg-secondary">Inactive</span>
                        <% } %>
                      </td>
                      <td><small><%= recipient.created_at %></small></td>
                      <td>
                        <div class="d-flex gap-2 flex-wrap">
                          <form method="POST" action="/admin/email-recipients/<%= recipient.id %>/toggle">
                            <button class="btn btn-sm btn-outline-warning" type="submit">
                              <%= recipient.is_active === 1 ? 'Deactivate' : 'Activate' %>
                            </button>
                          </form>

                          <form
                            method="POST"
                            action="/admin/email-recipients/<%= recipient.id %>/delete"
                            onsubmit="return confirm('Delete this recipient?');"
                          >
                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
<!doctype html>
<html>
<head>
  <title>Work Orders - Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/public/admin.css" />
</head>

<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <div class="admin-brand">Work Order Admin</div>
      <div class="admin-brand-subtitle">Manage reports, photos and technicians</div>

      <div class="admin-nav">
        <a href="/admin">Dashboard</a>
        <a class="active" href="/admin/work-orders">Work Orders</a>
        <a href="/admin/technicians">Technicians</a>
        <a href="/admin/email-recipients">Email Setup</a>
        <a href="/admin/ppt-settings">PPT Settings</a>
        <a href="/admin/activity-logs">Activity Logs</a>
        <a href="/admin/backups">Backups</a>

        <form method="POST" action="/admin/logout" class="mt-3">
          <button type="submit">Logout</button>
        </form>
      </div>
    </aside>

    <main class="admin-content">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
        <div>
          <h3 class="page-title">Work Orders</h3>
          <p class="page-subtitle">Review uploaded reports, check edited items, generate PPTs and send emails.</p>
        </div>

        <a href="/admin/work-orders" class="btn btn-outline-secondary">
          Reset Filters
        </a>
      </div>

      <div class="help-box">
        Use the <strong>Review</strong> button to open a work order, check photos, generate PPT, and send the report by email.
        If a report shows <strong>Edited</strong>, new photos were added after the original submission.
      </div>

      <div class="card admin-card mb-3">
        <div class="card-body">
          <form class="row g-2" method="GET" action="/admin/work-orders">
            <div class="col-md-4">
              <input
                class="form-control"
                name="search"
                placeholder="Search Work Order or Asset ID"
                value="<%= filters.search %>"
              />
            </div>

            <div class="col-md-3">
              <select class="form-select" name="status">
                <option value="">All Statuses</option>
                <option value="uploaded" <%= filters.status === 'uploaded' ? 'selected' : '' %>>Uploaded</option>
                <option value="received" <%= filters.status === 'received' ? 'selected' : '' %>>Received</option>
              </select>
            </div>

            <div class="col-md-3">
              <select class="form-select" name="technician">
                <option value="">All Technicians</option>
                <% technicians.forEach(function(tech) { %>
                  <option
                    value="<%= tech.id %>"
                    <%= String(filters.technician) === String(tech.id) ? 'selected' : '' %>
                  >
                    <%= tech.full_name %> - <%= tech.phone %>
                  </option>
                <% }) %>
              </select>
            </div>

            <div class="col-md-2">
              <button class="btn btn-primary w-100" type="submit">Filter</button>
            </div>
          </form>
        </div>
      </div>

      <div class="card admin-card">
        <div class="card-header">
          Uploaded Work Orders
        </div>

        <div class="card-body">
          <% if (workOrders.length === 0) { %>
            <p class="text-muted mb-0">No work orders found.</p>
          <% } else { %>
            <div class="table-responsive">
              <table class="table align-middle">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Work Order</th>
                    <th>Asset ID</th>
                    <th>Technician</th>
                    <th>Photos</th>
                    <th>Status</th>
                    <th>Edited</th>
                    <th>PPT</th>
                    <th>Email</th>
                    <th>Received</th>
                    <th>Action</th>
                  </tr>
                </thead>

                <tbody>
                  <% workOrders.forEach(function(order) { %>
                    <tr>
                      <td><%= order.id %></td>
                      <td class="fw-bold"><%= order.work_order_number %></td>
                      <td><%= order.asset_id || '-' %></td>
                      <td>
                        <%= order.technician_name || 'Unknown' %><br />
                        <small class="text-muted"><%= order.technician_phone || '' %></small>
                      </td>
                      <td><%= order.photo_count %></td>
                      <td><span class="badge bg-primary"><%= order.status %></span></td>

                      <td>
                        <% if (order.is_edited == 1) { %>
                          <span class="badge bg-warning text-dark">Edited</span>
                          <br />
                          <small class="text-muted"><%= order.edit_count || 1 %> time(s)</small>
                        <% } else { %>
                          <span class="badge bg-light text-dark border">Original</span>
                        <% } %>
                      </td>

                      <td>
                        <% if (order.ppt_status === 'needs_regeneration') { %>
                          <span class="badge bg-warning text-dark">Needs Regeneration</span>
                        <% } else if (order.ppt_status === 'generated') { %>
                          <span class="badge bg-success">Generated</span>
                        <% } else if (order.ppt_status === 'failed') { %>
                          <span class="badge bg-danger">Failed</span>
                        <% } else { %>
                          <span class="badge bg-secondary"><%= order.ppt_status || 'not_generated' %></span>
                        <% } %>
                      </td>

                      <td>
                        <% if (order.email_status === 'sent') { %>
                          <span class="badge bg-success">Sent</span>
                        <% } else if (order.email_status === 'test_mode') { %>
                          <span class="badge bg-info text-dark">Test Mode</span>
                        <% } else if (order.email_status === 'failed') { %>
                          <span class="badge bg-danger">Failed</span>
                        <% } else if (order.email_status === 'sending') { %>
                          <span class="badge bg-primary">Sending</span>
                        <% } else { %>
                          <span class="badge bg-secondary">Not Sent</span>
                        <% } %>
                      </td>

                      <td><small><%= order.received_at || '-' %></small></td>

                      <td>
                        <div class="d-flex gap-2 flex-wrap">
                          <a class="btn btn-sm btn-primary" href="/admin/work-orders/<%= order.id %>">
                            Review
                          </a>

                          <form
                            method="POST"
                            action="/admin/work-orders/<%= order.id %>/delete"
                            onsubmit="return confirm('Are you sure you want to delete this work order? This will also delete its photos and generated PPT.');"
                          >
                            <button class="btn btn-sm btn-outline-danger" type="submit">
                              Delete
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
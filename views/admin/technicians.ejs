<!doctype html>
<html>
<head>
  <title>Technicians - Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/public/admin.css" />
</head>

<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
  <div class="admin-logo-wrap">
    <div class="admin-logo">WO</div>
    <div>
      <div class="admin-brand">Work Order Admin</div>
      <div class="admin-brand-subtitle">Operations Portal</div>
    </div>
  </div>

  <div class="admin-nav">
    <a href="/admin">
      <span class="admin-nav-icon">▣</span>
      Dashboard
    </a>

    <a href="/admin/work-orders">
      <span class="admin-nav-icon">▤</span>
      Work Orders
    </a>

    <a class="active" href="/admin/technicians">
      <span class="admin-nav-icon">◉</span>
      Technicians
    </a>

    <a href="/admin/email-recipients">
      <span class="admin-nav-icon">✉</span>
      Email Setup
    </a>

    <a href="/admin/ppt-settings">
      <span class="admin-nav-icon">▧</span>
      PPT Settings
    </a>

    <a href="/admin/activity-logs">
      <span class="admin-nav-icon">◎</span>
      Activity Logs
    </a>

    <a href="/admin/backups">
      <span class="admin-nav-icon">⬒</span>
      Backups
    </a>

    <form method="POST" action="/admin/logout" class="mt-3">
      <button type="submit">
        <span class="admin-nav-icon">↳</span>
        Logout
      </button>
    </form>
  </div>
</aside>

    <main class="admin-content">
      <div class="mb-4">
        <h3 class="page-title">Technicians</h3>
        <p class="page-subtitle">Approve, reject, or delete technicians who use the mobile app.</p>
      </div>

      <div class="help-box">
        New technicians cannot log in until they are approved by admin.
      </div>

      <div class="card admin-card">
        <div class="card-header">Technician Management</div>

        <div class="card-body">
          <% if (technicians.length === 0) { %>
            <p class="text-muted mb-0">No technicians registered yet.</p>
          <% } else { %>
            <div class="table-responsive">
              <table class="table align-middle">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>QID</th>
                    <th>Job Title</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Action</th>
                  </tr>
                </thead>

                <tbody>
                  <% technicians.forEach(function(user) { %>
                    <tr>
                      <td class="fw-bold"><%= user.full_name %></td>
                      <td><%= user.phone %></td>
                      <td><%= user.qid_number || '-' %></td>
                      <td><%= user.job_title || '-' %></td>
                      <td>
                        <% if (user.status === 'approved') { %>
                          <span class="badge bg-success">Approved</span>
                        <% } else if (user.status === 'rejected') { %>
                          <span class="badge bg-danger">Rejected</span>
                        <% } else { %>
                          <span class="badge bg-warning text-dark">Pending</span>
                        <% } %>
                      </td>
                      <td><small><%= user.created_at %></small></td>
                      <td>
                        <div class="d-flex gap-2 flex-wrap">
                          <form method="POST" action="/admin/technicians/<%= user.id %>/approve">
                            <button class="btn btn-success btn-sm" type="submit">Approve</button>
                          </form>

                          <form method="POST" action="/admin/technicians/<%= user.id %>/reject">
                            <button class="btn btn-warning btn-sm" type="submit">Reject</button>
                          </form>

                          <form
                            method="POST"
                            action="/admin/technicians/<%= user.id %>/delete"
                            onsubmit="return confirm('Are you sure you want to permanently delete this technician? This will also delete all work orders, photos and PPT reports of this technician.');"
                          >
                            <button class="btn btn-outline-danger btn-sm" type="submit">
                              Delete
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>